generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../erd/ERD.svg"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//ตารางเก็บข้อมูลผู้ใช้
model User {
  id         Int      @id @default(autoincrement())
  googleId   String?  @unique
  name       String
  email      String   @unique
  phone      String?
  status     String   @default("active")
  created_at DateTime @default(now()) @db.Timestamp(6)

  body Body[]
  consents UserConsent[]

  @@map("User") //ระบุว่าตารางจริงใน PostgreSQL
}

//ตารางเก็บข้อมูลร่างกายของผู้ใช้
model Body {
  id          Int      @id @default(autoincrement())
  user_id     Int
  height      Decimal? @db.Decimal(5, 2) // ซม.
  weight      Decimal? @db.Decimal(5, 2) // กก.
  chest       Decimal? @db.Decimal(5, 2) // ซม.
  waist       Decimal? @db.Decimal(5, 2) // ซม.
  hips        Decimal? @db.Decimal(5, 2) // ซม.
  recorded_at DateTime @default(now()) @db.Timestamp(6)

  user User @relation(fields: [user_id], references: [id])
  images Image[]
  @@map("body")
}

//ตารางเก็บรูปภาพของผู้ใช้
model Image {
  id             Int      @id @default(autoincrement())
  body_id        Int
  s3             String?
  angle          String? //มุมของภาพ เช่น ด้านหน้า ด้านข้าง ด้านหลัง
  quality_status String? // ผ่าน, ไม่ผ่าน, รอดำเนินการ (ผลตรวจ AI)
  uploaded_at    DateTime @default(now()) @db.Timestamp(6)

  body Body @relation(fields: [body_id], references: [id])

  @@unique([body_id, angle])
  @@map("image")
}

//ตารางเก็บการยินยอมของผู้ใช้
model UserConsent {
  id         Int       @id @default(autoincrement())
  user_id    Int
  type       String  // ยินยอมเรื่อง pdpa, ai_processing
  granted    Boolean
  granted_at DateTime  @default(now()) @db.Timestamp(6)
  revoked_at DateTime? @db.Timestamp(6)

  user User @relation(fields: [user_id], references: [id])

  @@map("user_consents")
}

//----------------------------------------------------------------//

// ร้านค้า
model Store {
  id        Int       @id @default(autoincrement())
  name      String
  status    String?   @default("active")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  products Product[]

  @@map("stores")
}


// เสื้อผ้าแต่ละชิ้นของร้าน (ชื่อ หมวด)
model Product {
  id          Int       @id @default(autoincrement())
  storeId     Int       @map("store_id") 
  name        String
  category    String?   // เสื้อ กางเกง กระโปรง กำได แหวน
  description String?
  status      String?   @default("active")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  store      Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sizeCharts ProductSizeChart[]
  images     ProductImage[]

  @@index([storeId])
  @@map("products")
}

// ตารางเก็บขนาดของเสื้อผ้าแต่ละชิ้น (S, M, L)
model ProductSizeChart {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  size      String   // S, M, L
  chest     Decimal? @db.Decimal(5, 2)
  waist     Decimal? @db.Decimal(5, 2)
  hips      Decimal? @db.Decimal(5, 2)
  length    Decimal? @db.Decimal(5, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_size_charts")
}

// ตารางเก็บรูปภาพของเสื้อผ้าแต่ละชิ้น
model ProductImage {
  id         Int       @id @default(autoincrement())
  productId  Int       @map("product_id")
  s3Key      String    @map("s3_key")
  uploadedAt DateTime? @default(now()) @map("uploaded_at") @db.Timestamp(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

