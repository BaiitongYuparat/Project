generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  googleId     String?       @unique
  name         String?
  email        String        @unique
  status       String        @default("active")
  created_at   DateTime      @default(now()) @db.Timestamp(6)
  body         Body[]
  userConsents UserConsent[]

  @@map("User")
}

model Body {
  id          String   @id @default(uuid())
  user_id     String
  height      Decimal? @db.Decimal(5, 2)
  weight      Decimal? @db.Decimal(5, 2)
  chest       Decimal? @db.Decimal(5, 2)
  waist       Decimal? @db.Decimal(5, 2)
  hips        Decimal? @db.Decimal(5, 2)
  recorded_at DateTime @default(now()) @db.Timestamp(6)
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  images      Image[]

  @@map("body")
}

model Image {
  id             String   @id @default(uuid())
  body_id        String
  s3             String?
  angle          String?
  quality_status String?
  uploaded_at    DateTime @default(now()) @db.Timestamp(6)
  body           Body     @relation(fields: [body_id], references: [id])

  @@unique([body_id, angle])
  @@map("image")
}

model UserConsent {
  id         String    @id @default(uuid())
  user_id    String
  type       String
  granted    Boolean
  granted_at DateTime  @default(now()) @db.Timestamp(6)
  revoked_at DateTime? @db.Timestamp(6)
  user       User      @relation(fields: [user_id], references: [id])

  @@unique([user_id, type]) //1 คนห้ามมี type ซ้ำกัน
  @@map("user_consents")
  
}

model Clothing {
  id         String   @id @default(uuid())
  user_id    String
  name       String?
  category   String
  image_url  String
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)

  @@index([user_id])
  @@map("clothings")
}
